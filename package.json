{
  "name": "rayflix-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio of Akpe Samuel (rayflixthetechbro), frontend developer",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/sync-github.mjs",
    "sync:force": "node scripts/sync-github.mjs --force",
